---
import PageLayout from '../layouts/PageLayout.astro';

const photos = [
  '/images/IMG_8430.jpg',
  '/images/IMG_8431.jpg',
  '/images/IMG_8432.jpg',
  '/images/IMG_8433.jpg',
  '/images/IMG_8434.jpg',
  '/images/IMG_8435.jpg',
];
---

<PageLayout
  title="Gallery"
  eyebrow="Photography"
  description=""
>
  <div class="photo-gallery">
    {photos.map((photo) => (
      <img
        src={photo}
        alt="Gallery photograph"
        loading="lazy"
      />
    ))}
  </div>
</PageLayout>

<style>
  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 30px;
  }

  .photo-gallery img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }

  @media (max-width: 600px) {
    .photo-gallery {
      grid-template-columns: 1fr;
    }
  }
  :global(body h1) {
  font-family: 'UnifrakturCook', cursive !important;
  font-size: clamp(3.5rem, 9vw, 6rem) !important;
  font-weight: 700;
  color: #263f51;
  letter-spacing: 1px;
}
</style>